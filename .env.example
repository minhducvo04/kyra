# Copy this file to .env and fill in your own values. Never commit .env.
ANTHROPIC_API_KEY=your-api-key-here

# --- Exposing the server beyond this laptop (all optional; unset = local-only) ---
# Set a long random token to turn the gate on. Unset, there is no gate at all, which
# is correct for 127.0.0.1 and wrong for anything else. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# KYRA_API_TOKEN=
# 0.0.0.0 to accept connections from the LAN (the Vision Pro client) or a container.
# KYRA_HOST=127.0.0.1
# The loopback exemption reads the socket peer, never X-Forwarded-For. Set this false
# whenever a reverse proxy runs on the SAME host, where every caller looks local.
# KYRA_TRUST_LOOPBACK=true
# KYRA_SESSION_TTL_DAYS=30

# --- Voice (optional) ---
# A faster Claude model for SPOKEN replies only (docs/voice-latency.md: haiku reaches its
# first token ~3x sooner). Written turns and every tool-calling turn keep the default.
# KYRA_VOICE_MODEL=claude-haiku-4-5
