# Copy this file to .env and fill in your own values. Never commit .env.
ANTHROPIC_API_KEY=your-api-key-here

# Opt in explicitly to the legacy background assignment stages.
KYRA_LOOP_HEADLESS=false
# Pin the visible Codex task by its ID.
KYRA_CODEX_TASK_ID=
# Pin the visible Claude Code conversation by its exact name.
KYRA_CLAUDE_SESSION_NAME=

# Enable only on the owner's own machine. Sensitive local stores also require
# the personal tenant and SQLite under KYRA_DATA_DIR (or an in-memory database).
# Defaults to false; a container must never qualify merely because it uses SQLite.
# KYRA_OWNER_MACHINE=false

# --- Humidifier (optional, personal tenant only) ---
# VeSync accounts with two-factor sign-in are not supported by pyvesync.
# VESYNC_USERNAME=
# VESYNC_PASSWORD=

# Tool approval policy: comma-separated names, whitespace allowed. Empty means none.
# Unset defaults to local bookkeeping and drafts. These can never be preapproved:
# humidifier_control, autofill_job_application, copy_outreach_note.
# KYRA_PREAPPROVED_TOOLS=add_reminder,complete_reminder,snooze_reminder,save_learning_item,mark_learning_reviewed,add_job_application,update_job_application_status,set_application_resume,draft_application_material,save_memory_note,add_outreach_contact,update_outreach_status,draft_outreach_note,target_job_posting,start_focus_block,end_focus_block

# --- Exposing the server beyond this laptop (all optional; unset = local-only) ---
# Set a long random token to turn the gate on. Unset, there is no gate at all, which
# is correct for 127.0.0.1 and wrong for anything else. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# KYRA_API_TOKEN=
# 0.0.0.0 to accept connections from the LAN (the Vision Pro client) or a container.
# KYRA_HOST=127.0.0.1
# Non-loopback listeners require both a token and TLS. For a second listener,
# prefer --tls-cert/--tls-key flags so the local HTTP job stays unchanged.
KYRA_TLS_CERT=
KYRA_TLS_KEY=
# Only behind an actual TLS-terminating proxy with direct access to this port restricted.
# The token is still required; this flag does not enable encryption or trust forwarded headers.
KYRA_TLS_TERMINATED_UPSTREAM=false
# The loopback exemption reads the socket peer, never X-Forwarded-For. Set this false
# whenever a reverse proxy runs on the SAME host, where every caller looks local.
# KYRA_TRUST_LOOPBACK=true
# KYRA_SESSION_TTL_DAYS=30

# --- Voice (optional) ---
# A faster Claude model for SPOKEN replies only (docs/voice-latency.md: haiku reaches its
# first token ~3x sooner). Written turns and every tool-calling turn keep the default.
# KYRA_VOICE_MODEL=claude-haiku-4-5

# Outbound cloud requests: off, dry_run, or enforce. Dry-run reports unreviewed legacy
# labels without interrupting chat; configured secret values are still refused.
# KYRA_OUTBOUND_GATE=dry_run
# Standing release grants, comma-separated; only conversation and job_search are allowed.
# An empty value revokes all grants. Every class on a block must have a grant.
# KYRA_RELEASE_GRANTS=conversation,job_search

# Experimental fixed-label routing threshold; 0 preserves existing routing.
# Scores are relative label likelihoods, not calibrated certainty.
KYRA_ROUTER_UNSURE_TO_CLAUDE=0

# Staged local model for owner-reviewed privacy suggestions (never downloaded automatically).
# KYRA_SHADOW_LABEL_MODEL_DIR=~/kyra-model-trials/gemma-4-31b-it-4bit
# Parent of local_llm_models (HF_HOME), voice_models and bench_hf. Default: ~/kyra-models once it exists, else data/.
# KYRA_MODELS_DIR=~/kyra-models
# Obsidian vault Team result notes are saved into. Default: data/private_docs/obsidian/Kyra.
# KYRA_OBSIDIAN_VAULT=

# Explicitly exported images/PDFs; empty disables local Apple Vision ingestion.
KYRA_HANDWRITING_INBOX=

# Local EventKit calendar reader (macOS 14+). Reads only; first use requests Calendar permission.
KYRA_CALENDAR_ENABLED=false
# Comma-separated calendar names. Empty means all calendars accessible on this Mac.
KYRA_CALENDAR_NAMES=

# Gmail metadata reader. Empty credential path disables it; authorise explicitly with scripts/mail_authorise.py.
KYRA_GMAIL_CREDENTIALS=
# Optional token path override, under KYRA_DATA_DIR. Default: DATA_DIR/gmail/token.json.
# KYRA_GMAIL_TOKEN=/absolute/path/to/private/data/gmail/token.json

# Optional local Health Auto Export JSON folder (for example an iCloud-synced folder).
# Empty keeps the manual Health export path. Enable Summarize Data in the exporter.
KYRA_HEALTH_AUTO_DIR=

# Optional local Kasa KL125 (requires TP-Link account credentials for KLAP).
KASA_BULB_HOST=
KASA_USERNAME=
KASA_PASSWORD=
